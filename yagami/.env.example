# copy to .env and fill in. all vars are required (Config::from_env fails fast if any are missing).

# address the server binds to.
YAGAMI_BIND="0.0.0.0:39173"

# origin allowed to make cross-origin REST calls (the deployed client).
# prod: https://requiem-dn.dev -- for local dev set this to your client's dev origin (e.g. http://localhost:5173)
YAGAMI_ALLOWED_ORIGIN="https://requiem-dn.dev"

# postgres connection string. tables are created automatically by migrations on boot.
# local dev: postgres://USER:PASSWORD@localhost:5432/yagami
DATABASE_URL="postgres://postgres:postgres@localhost:5432/yagami"
