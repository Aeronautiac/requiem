# copy to .env and fill in. all vars are required (Config::from_env fails fast if any are missing).

# address the server binds to. behind Caddy in prod this must not be reachable from outside: the
# per-IP rate limit trusts X-Forwarded-For, which anyone connecting directly could forge.
YAGAMI_BIND="0.0.0.0:39173"

# origin allowed to make cross-origin REST calls (the deployed client).
# prod: https://requiem-dn.dev -- for local dev set this to your client's dev origin (e.g. http://localhost:5173)
YAGAMI_ALLOWED_ORIGIN="https://requiem-dn.dev"

# postgres connection string. tables are created automatically by migrations on boot.
# local dev: postgres://USER:PASSWORD@localhost:5432/yagami
DATABASE_URL="postgres://postgres:postgres@localhost:5432/yagami"
# the most database connections yagami holds open at once.
YAGAMI_DATABASE_POOL_SIZE="8"

# --- games ---

# the most games that may be resident (awake, with a runtime child) at once. a hibernated game costs
# only its DB row; waking one past this cap is refused with ServerAtCapacity.
YAGAMI_MAX_RESIDENT="32"
# seconds a game goes without a connection or an outstanding ticket before it hibernates.
YAGAMI_HIBERNATE_AFTER_SECS="1800"
# seconds between null ticks, which advance a game's clock while nobody acts.
YAGAMI_NULL_TICK_INTERVAL_SECS="5"
# seconds the runtime child gets to take or answer one input before it is treated as hung.
YAGAMI_ENGINE_TIMEOUT_SECS="5"
# failed boots retry with exponential backoff from this delay (2x, 4x, ...), giving up after
# MAX_RETRIES attempts.
YAGAMI_BOOT_RETRY_BASE_MS="500"
YAGAMI_BOOT_MAX_RETRIES="10"
# seconds a game whose boot gave up is refused a wake (GameBootFailed), so a broken game is not
# re-booted by every client retry.
YAGAMI_BOOT_COOLDOWN_SECS="600"

# --- connections ---

# tickets a key may hold at once, claimed or not -- and so its most simultaneous connections.
YAGAMI_TICKET_LIMIT="5"
# seconds an issued ticket waits to be claimed before it is dropped.
YAGAMI_TICKET_TIMEOUT_SECS="15"
# batches a connection's outbox holds before it counts as too slow and is dropped.
YAGAMI_OUTBOX_SIZE="50"
# the most commands sent in one websocket message; larger batches are split.
YAGAMI_BATCH_SIZE="32"
# seconds between the server's pings, and of silence before a connection is reaped as dead.
YAGAMI_HEARTBEAT_INTERVAL_SECS="5"
YAGAMI_HEARTBEAT_TIMEOUT_SECS="15"

# --- abuse limits ---

# the largest websocket message a client may send, in bytes; a larger one closes the socket.
YAGAMI_MAX_INPUT_BYTES="16384"
# the largest REST request body, in bytes.
YAGAMI_MAX_BODY_BYTES="4096"
# rate limits: one token every PERIOD_MS, saving up to BURST while idle.
# inputs, per connection. over the limit, the connection stops reading until a token frees up.
YAGAMI_INPUT_PERIOD_MS="200"
YAGAMI_INPUT_BURST="20"
# REST requests, per client IP. over the limit is answered RateLimited (429).
YAGAMI_REQUEST_PERIOD_MS="500"
YAGAMI_REQUEST_BURST="10"
